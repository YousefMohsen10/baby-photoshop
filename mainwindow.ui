    <widget class="QSlider" name="brightnessSlider">
     <property name="geometry">
      <rect>
       <x>10</x>
       <y>70</y>
       <width>160</width>
       <height>18</height>
      </rect>
     </property>
     <property name="styleSheet">
      <string notr="true">QSlider::groove:horizontal {
    border: 1px solid #333;
    background: #1e1e1e;
    height: 6px;
    border-radius: 3px;
}

QSlider::groove:horizontal:hover:enabled {
    background: #2c2c2c;
}

QSlider::sub-page:horizontal:enabled {
    background: #00ffff;
    border: 1px solid #00ffff;
    height: 6px;
    border-radius: 3px;
}

QSlider::add-page:horizontal:enabled {
    background: #2e2e2e;
    border: 1px solid #222;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal:enabled {
    background: #00ffff;
    border: 1px solid #00ffff;
    width: 14px;
    height: 14px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 7px;
    transition: all 0.2s ease-in-out;
}

QSlider::handle:horizontal:hover:enabled {
    background: #33ffff;
    border: 1px solid #33ffff;
}

QSlider::handle:horizontal:pressed:enabled {
    background: #008b8b;
    border: 1px solid #008b8b;
}

/* Disabled appearance */
QSlider:disabled {
    background: #1e1e1e;
}

QSlider::groove:horizontal:disabled {
    background: #2e2e2e;
    border: 1px solid #2e2e2e;
}

QSlider::sub-page:horizontal:disabled {
    background: #444;
    border: 1px solid #444;
}

QSlider::add-page:horizontal:disabled {
    background: #2e2e2e;
    border: 1px solid #2e2e2e;
}

QSlider::handle:horizontal:disabled {
    background: #555;
    border: 1px solid #444;
}
</string>
     </property>
